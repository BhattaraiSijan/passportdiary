{
  "name": "passportdiary",
  "version": "0.1.0",
  "scripts": {
    "test": "vitest run",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
    "lint": "eslint .",
    "format": "prettier --write .",
    "data:import": "tsx scripts/import-visa-matrix.ts",
    "data:shapes": "tsx scripts/build-shapes.ts",
    "data:validate": "tsx scripts/validate.ts",
    "data:build": "npm run data:import && npm run data:shapes && npm run data:validate",
    "check": "npm run typecheck && npm run lint && npm run test && npm run data:validate"
  },
  "private": true,
  "type": "module",
  "dependencies": {
    "@vis.gl/react-maplibre": "^8.1.3",
    "maplibre-gl": "^6.11.2",
